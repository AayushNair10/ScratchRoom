{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scratchroom-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "SIGNALING", "class_name": "SignalingHub" }]
  },
  // SQLite-backed Durable Objects are available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalingHub"] }],
  "vars": {
    // Only these pages may use the signaling server and get TURN credentials.
    // Comma-separated; leave empty to allow any origin.
    "ALLOWED_ORIGINS": "https://scratchroom.pages.dev,http://localhost:5173,http://127.0.0.1:5173"
  }
}
