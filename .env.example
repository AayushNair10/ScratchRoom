# Copy to .env.local and adjust. All values are baked in at build time.

# Comma-separated y-webrtc signaling servers (wss:// in production), e.g. your
# Cloudflare Worker from ./signaling. In dev, if unset, ws://<page-host>:4444 is
# used (start it with `npm run signaling`).
VITE_SIGNALING=

# Optional STUN/TURN servers as a JSON array (needed only for strict networks).
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]

# Which service runs C, C++ and Java: "wandbox" (default) or "piston".
VITE_RUNNER=wandbox
VITE_WANDBOX_URL=https://wandbox.org
VITE_PISTON_URL=https://emkc.org/api/v2/piston
