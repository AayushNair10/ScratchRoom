# Copy to .env.local and adjust. All values are baked in at build time.

# Comma-separated y-webrtc signaling servers (wss:// in production).
# In dev, if unset, ws://<page-host>:4444 is used (start it with `npm run signaling`).
VITE_SIGNALING=

# Piston API used to run C, C++ and Java.
VITE_PISTON_URL=https://emkc.org/api/v2/piston
